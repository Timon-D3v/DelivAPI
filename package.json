{
  "name": "delivapi",
  "version": "2.0.0",
  "description": "A personal CDN/WebAPI for uploading and pulling images and other files from.",
  "homepage": "https://github.com/Timon-D3v/DelivAPI.git#readme",
  "author": "Timon Fiedler",
  "license": "MIT",
  "main": "src/app.ts",
  "type": "module",
  "types": "src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timon-D3v/DelivAPI.git"
  },
  "bugs": {
    "url": "https://github.com/Timon-D3v/DelivAPI.git/issues"
  },
  "scripts": {
    "dev": "docker compose -f ./dev/compose.yaml up -d  && tsx watch src/app.ts",
    "build": "tsc",
    "watch": "tsc --watch --noEmit",
    "start": "tsc && node dist/app.js",
    "start:last": "node dist/app.js",
    "format": "prettier --write \"{src,public}/**/*.{ts,html,css,js}\"",
    "fmt": "npm run format",
    "docker:build": "docker build . -t delivapi:latest",
    "docker:run": "docker run --rm --name delivapi -p 8080:8080 --env-file ./docker.env delivapi",
    "docker:stop": "docker stop delivapi",
    "docker:buildx": "docker buildx build --platform linux/arm64,linux/amd64 -t delivapi",
    "docker:buildx:push": "docker buildx build --platform linux/arm64,linux/amd64 . -t timond3v/delivapi:latest --push"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "delivapi-client": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.22.1",
    "node-mailjet": "^6.0.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.2",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "API",
    "CDN",
    "file",
    "upload",
    "pull",
    "image",
    "webapi",
    "personal"
  ]
}
