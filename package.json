{
  "name": "delivapi",
  "version": "2.1.1",
  "description": "A personal CDN/WebAPI for uploading and pulling images and other files from.",
  "homepage": "https://github.com/Timon-D3v/DelivAPI.git#readme",
  "author": "Timon Fiedler",
  "license": "MIT",
  "main": "src/app.ts",
  "type": "module",
  "types": "src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timon-D3v/DelivAPI.git"
  },
  "bugs": {
    "url": "https://github.com/Timon-D3v/DelivAPI.git/issues"
  },
  "scripts": {
    "dev": "docker compose -f ./dev/compose.yaml up -d  && tsx watch src/app.ts",
    "build": "tsc",
    "watch": "tsc --watch --noEmit",
    "start": "tsc && node dist/app.js",
    "start:last": "node dist/app.js",
    "format": "prettier --write \"{src,public}/**/*.{ts,html,css,js}\"",
    "fmt": "npm run format",
    "push": "npm run fmt && npm run build && sh dockerize.sh"
  },
  "dependencies": {
    "@file-type/av": "^0.3.0",
    "@file-type/cfbf": "^0.2.2",
    "@file-type/pdf": "^0.3.0",
    "@file-type/xml": "^1.2.0",
    "cors": "^2.8.6",
    "delivapi-client": "^2.1.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "file-type": "^22.1.0",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "API",
    "CDN",
    "file",
    "upload",
    "pull",
    "image",
    "webapi",
    "personal"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
